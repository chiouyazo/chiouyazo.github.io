---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<div class="page">

		<div class="bg-orb bg-orb-1"></div>
		<div class="bg-orb bg-orb-2"></div>

		<section class="hero">
			<div class="wrap">
				<h1>Max-Leon Ernst</h1>
				<p class="location">18 · Near Düsseldorf, Germany</p>
				<p class="bio">I like building clean desktop interfaces and tools that automate tedious work.</p>
				<div class="stack">
					<div class="stack-group">
						<span class="stack-tag">C#</span>
						<span class="stack-tag">TypeScript</span>
						<span class="stack-tag">SQL</span>
					</div>
					<div class="stack-group">
						<span class="stack-tag">.NET Core</span>
						<span class="stack-tag">.NET Framework</span>
						<span class="stack-tag">ASP.NET Core</span>
						<span class="stack-tag">WPF</span>
						<span class="stack-tag">WinForms</span>
						<span class="stack-tag">Avalonia</span>
						<span class="stack-tag">Vue.js</span>
						<span class="stack-tag">Entity Framework</span>
						<span class="stack-tag">ReactiveUI</span>
						<span class="stack-tag">CommunityToolkit.Mvvm</span>
						<span class="stack-tag">WebAssembly</span>
						<span class="stack-tag">Autofac</span>
					</div>
					<div class="stack-group">
						<span class="stack-tag">Azure</span>
						<span class="stack-tag">Azure Functions</span>
						<span class="stack-tag">Docker</span>
						<span class="stack-tag">Traefik</span>
						<span class="stack-tag">Portainer</span>
						<span class="stack-tag">Nexus OSS</span>
						<span class="stack-tag">Ubuntu</span>
						<span class="stack-tag">Raspberry Pi</span>
					</div>
					<div class="stack-group">
						<span class="stack-tag">Git</span>
						<span class="stack-tag">Bitbucket</span>
						<span class="stack-tag">JIRA</span>
						<span class="stack-tag">Confluence</span>
						<span class="stack-tag">SQL Server</span>
						<span class="stack-tag">LiteDB</span>
						<span class="stack-tag">Serilog</span>
						<span class="stack-tag">Selenium</span>
						<span class="stack-tag">DevExpress</span>
					</div>
					<div class="stack-group">
						<span class="stack-tag">OpenAI</span>
						<span class="stack-tag">Anthropic Claude</span>
						<span class="stack-tag">Ollama</span>
						<span class="stack-tag">OpenCV</span>
					</div>
					<div class="stack-group">
						<span class="stack-tag">OOP</span>
						<span class="stack-tag">MVVM</span>
						<span class="stack-tag">IoC</span>
						<span class="stack-tag">WebSockets</span>
						<span class="stack-tag">Agile</span>
					</div>
				</div>
				<div class="socials">
					<a href="https://github.com/chiouyazo" class="social-btn" target="_blank" rel="noopener" aria-label="GitHub">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
							<path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
						</svg>
					</a>
					<a href="https://www.linkedin.com/in/max-leon-ernst/" class="social-btn" target="_blank" rel="noopener" aria-label="LinkedIn">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
							<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
						</svg>
					</a>
					<a href="https://store.steampowered.com/app/4071050/Papered/" class="social-btn" target="_blank" rel="noopener" aria-label="Steam">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
							<path d="M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142V8.91c0-2.495 2.028-4.524 4.524-4.524 2.494 0 4.524 2.029 4.524 4.524s-2.03 4.525-4.524 4.525h-.105l-4.076 2.911c0 .052.004.105.004.159 0 1.875-1.515 3.396-3.39 3.396-1.635 0-3.016-1.173-3.331-2.727L.436 15.27C1.862 20.307 6.486 24 11.979 24c6.627 0 11.999-5.373 11.999-12S18.606 0 11.979 0zM7.54 18.21l-1.473-.61c.262.543.714.999 1.314 1.25 1.297.539 2.793-.076 3.332-1.375.263-.63.264-1.319.005-1.949s-.75-1.121-1.377-1.383c-.624-.26-1.29-.249-1.878-.03l1.523.63c.956.4 1.409 1.5 1.009 2.455-.397.957-1.497 1.41-2.455 1.012H7.54zm11.415-9.303c0-1.662-1.353-3.015-3.015-3.015-1.665 0-3.015 1.353-3.015 3.015 0 1.665 1.35 3.015 3.015 3.015 1.662 0 3.015-1.35 3.015-3.015zm-5.273-.005c0-1.252 1.013-2.266 2.265-2.266 1.249 0 2.266 1.014 2.266 2.266 0 1.251-1.017 2.265-2.266 2.265-1.252 0-2.265-1.014-2.265-2.265z"/>
						</svg>
					</a>
				</div>
			</div>
		</section>

		<section class="section">
			<div class="wrap">
				<p class="section-label">Projects</p>
				<div class="projects">

					<a href="https://store.steampowered.com/app/4071050/Papered/" class="card" target="_blank" rel="noopener">
						<p class="card-tag">Game · Steam</p>
						<h3>Papered</h3>
						<p class="card-desc">A fast-paced first-person arena hack-and-slash set inside a living sketchbook. Fight paper enemies, collect fragments, and build your run.</p>
						<div class="card-footer">
							<span class="tag">Unity</span>
							<span class="tag">C#</span>
							<span class="card-arrow">→</span>
						</div>
					</a>

					<a href="https://github.com/chiouyazo/StorkDrop" class="card" target="_blank" rel="noopener">
						<p class="card-tag">Open Source · GitHub</p>
						<h3>StorkDrop</h3>
						<p class="card-desc">Manifest-driven software deployment for servers and workstations. Browse, install, and update software from Nexus OSS registries, with a WPF marketplace UI and CLI support.</p>
						<div class="card-footer">
							<span class="tag">C#</span>
							<span class="tag">.NET</span>
							<span class="tag">WPF</span>
							<span class="card-arrow">→</span>
						</div>
					</a>

				</div>
			</div>
		</section>

		<section class="section">
			<div class="wrap">
				<p class="section-label">Experience</p>
				<div class="jobs">

					<div class="job">
						<div class="job-logo logo-bg">
							<img src="https://creativity-gmbh.imgbolt.de/media/3b/48/68/1680266132/creativity_logo.svg" alt="creativITy GmbH" />
						</div>
						<div class="job-body">
							<div class="job-top">
								<div>
									<p class="job-role">C# Software Engineer</p>
									<p class="job-company">creativITy GmbH · Full-time · Hybrid, Mettmann</p>
								</div>
								<span class="job-period">Aug 2025 – Present</span>
							</div>
							<p class="job-desc">.NET Framework and .NET Core development.</p>
						</div>
					</div>

					<div class="job">
						<div class="job-logo logo-bg">
							<img src="https://avatars.githubusercontent.com/u/181200666?s=200&v=4" alt="AutoTF" />
						</div>
						<div class="job-body">
							<div class="job-top">
								<div>
									<p class="job-role">Founder & Engineer</p>
									<p class="job-company">AutoTF · Self-employed · Remote</p>
								</div>
								<span class="job-period">Aug 2024 – Aug 2025</span>
							</div>
							<p class="job-desc">Led development of train automation systems for the German market. Full ownership across system architecture, embedded development, cloud engineering, and sales partnerships with railway operators.</p>
						</div>
					</div>

					<div class="job">
						<div class="job-logo logo-bg logo-empower">
							<img src="https://www.empowersuite.com/hubfs/Marketing/Logos/empower%20Logos/svg%20colour/empower%20with%20claim%20be%20your%20best.svg" alt="empower" />
						</div>
						<div class="job-body">
							<div class="job-top">
								<div>
									<p class="job-role">Fullstack C# Software Engineer</p>
									<p class="job-company">empower · Apprenticeship · Cologne, on-site</p>
								</div>
								<span class="job-period">Aug 2023 – Oct 2024</span>
							</div>
							<p class="job-desc">Fullstack development of the empower AI Assistant.</p>
						</div>
					</div>

					<div class="job">
						<div class="job-logo logo-bg logo-empower">
							<img src="https://www.empowersuite.com/hubfs/Marketing/Logos/empower%20Logos/svg%20colour/empower%20with%20claim%20be%20your%20best.svg" alt="empower" />
						</div>
						<div class="job-body">
							<div class="job-top">
								<div>
									<p class="job-role">Software Developer</p>
									<p class="job-company">empower · Internship · Cologne, on-site</p>
								</div>
								<span class="job-period">Feb – Mar 2023</span>
							</div>
							<p class="job-desc">Software development internship.</p>
						</div>
					</div>

					<div class="job">
						<div class="job-logo logo-bg">
							<img src="https://www.schwelm.de/typo3conf/ext/configschwelm/Resources/Public/Images/wappen.png" alt="Stadt Schwelm" />
						</div>
						<div class="job-body">
							<div class="job-top">
								<div>
									<p class="job-role">System Administrator</p>
									<p class="job-company">Stadt Schwelm · Internship · Schwelm, on-site</p>
								</div>
								<span class="job-period">Mar 2022</span>
							</div>
							<p class="job-desc">3-week school internship as IT systems integrator.</p>
						</div>
					</div>

				</div>
			</div>
		</section>

	</div>
</Layout>

<style>
	.page {
		position: relative;
		overflow-x: hidden;
	}

	.wrap {
		width: 100%;
		max-width: 1100px;
		margin: 0 auto;
		padding: 0 clamp(28px, 7vw, 96px);
		position: relative;
		z-index: 1;
	}

	.bg-orb {
		position: fixed;
		border-radius: 50%;
		filter: blur(130px);
		pointer-events: none;
		z-index: 0;
	}

	.bg-orb-1 {
		width: 900px;
		height: 900px;
		background: rgba(129, 140, 248, 0.2);
		top: -350px;
		right: -250px;
	}

	.bg-orb-2 {
		width: 700px;
		height: 700px;
		background: rgba(192, 132, 252, 0.15);
		bottom: -100px;
		left: -250px;
	}

	.hero {
		padding: clamp(64px, 10vh, 100px) 0 clamp(32px, 4vh, 48px);
	}

	h1 {
		font-size: clamp(2.4rem, 5vw, 3.4rem);
		font-weight: 700;
		letter-spacing: -0.04em;
		line-height: 1.05;
		background: linear-gradient(130deg, #ffffff 10%, #a78bfa 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		margin-bottom: 12px;
		filter: drop-shadow(0 0 40px rgba(167, 139, 250, 0.35));
	}

	.location {
		font-size: 16px;
		color: #6b7280;
		margin-top: 8px;
		margin-bottom: 6px;
	}

	.bio {
		font-size: 16px;
		line-height: 1.6;
		color: #64748b;
		margin-bottom: 28px;
	}

	.stack {
		display: flex;
		flex-direction: column;
		gap: 10px;
		margin-bottom: 36px;
	}

	.stack-group {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}

	.stack-tag {
		font-size: 13px;
		font-weight: 500;
		color: #a5b4fc;
		background: rgba(129, 140, 248, 0.08);
		border: 1px solid rgba(129, 140, 248, 0.18);
		border-radius: 8px;
		padding: 4px 11px;
	}

	.socials {
		display: flex;
		gap: 12px;
	}

	.social-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		border-radius: 10px;
		color: #6b7280;
		border: 1px solid rgba(255, 255, 255, 0.08);
		transition: color 0.2s, border-color 0.2s, transform 0.2s;
		text-decoration: none;
	}

	.social-btn:hover {
		color: #a5b4fc;
		border-color: rgba(129, 140, 248, 0.35);
		transform: translateY(-2px);
	}

	.section {
		padding: clamp(24px, 3vh, 40px) 0;
	}

	.section-label {
		font-size: 24px;
		font-weight: 600;
		letter-spacing: -0.02em;
		color: #e2e8f0;
		margin-bottom: 28px;
		text-shadow: 0 0 40px rgba(129, 140, 248, 0.5);
	}

	.jobs {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.job {
		display: flex;
		gap: 20px;
		padding: 20px;
		border-radius: 14px;
		transition: background 0.2s;
	}

	.job:hover {
		background: rgba(255, 255, 255, 0.03);
	}

	.job-logo {
		width: 64px;
		height: 64px;
		border-radius: 12px;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		margin-top: 2px;
		overflow: hidden;
	}

	.job-logo img {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.logo-bg {
		background: white;
		padding: 8px 10px;
	}

	.logo-empower img {
		transform: scale(1.15) translate(1px, -2px);
	}

	.job-body {
		flex: 1;
		min-width: 0;
	}

	.job-top {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 16px;
		margin-bottom: 8px;
	}

	.job-role {
		font-size: 16px;
		font-weight: 600;
		color: #f1f5f9;
		margin-bottom: 3px;
		text-shadow: 0 0 20px rgba(129, 140, 248, 0.3);
	}

	.job-company {
		font-size: 14px;
		color: #818cf8;
	}

	.job-period {
		font-size: 13px;
		color: #6b7280;
		white-space: nowrap;
		flex-shrink: 0;
		margin-top: 2px;
	}

	.job-desc {
		font-size: 14px;
		line-height: 1.7;
		color: #94a3b8;
	}

	.projects {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 16px;
	}

	.card {
		display: flex;
		flex-direction: column;
		padding: 32px;
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.07);
		border-radius: 18px;
		text-decoration: none;
		transition: background 0.2s, border-color 0.2s, transform 0.2s;
		position: relative;
		overflow: hidden;
	}

	.card::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: 18px;
		background: linear-gradient(135deg, rgba(129, 140, 248, 0.06) 0%, transparent 60%);
		opacity: 0;
		transition: opacity 0.3s;
	}

	.card:hover {
		background: rgba(255, 255, 255, 0.05);
		border-color: rgba(129, 140, 248, 0.3);
		transform: translateY(-3px);
		box-shadow: 0 8px 40px rgba(129, 140, 248, 0.12);
	}

	.card:hover::after {
		opacity: 1;
	}

	.card-tag {
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: #a5b4fc;
		margin-bottom: 14px;
	}

	.card h3 {
		font-size: 24px;
		font-weight: 650;
		color: #f8fafc;
		margin-bottom: 12px;
		letter-spacing: -0.02em;
		text-shadow: 0 0 24px rgba(167, 139, 250, 0.35);
	}

	.card-desc {
		font-size: 15px;
		line-height: 1.75;
		color: #94a3b8;
		flex: 1;
		margin-bottom: 28px;
	}

	.card-footer {
		display: flex;
		align-items: center;
		gap: 6px;
	}

	.tag {
		font-size: 12px;
		font-weight: 500;
		color: #a5b4fc;
		background: rgba(129, 140, 248, 0.1);
		border: 1px solid rgba(129, 140, 248, 0.2);
		border-radius: 6px;
		padding: 3px 9px;
	}

	.card-arrow {
		margin-left: auto;
		font-size: 18px;
		color: #334155;
		transition: color 0.2s, transform 0.2s;
	}

	.card:hover .card-arrow {
		color: #818cf8;
		transform: translateX(4px);
	}

	@media (max-width: 640px) {
		.projects {
			grid-template-columns: 1fr;
		}

		.job-top {
			flex-direction: column;
			gap: 4px;
		}
	}
</style>
